---
import '../styles/fonts.css';
import interUrl from '../assets/fonts/inter.woff2?url';
import interTightUrl from '../assets/fonts/inter-tight.woff2?url';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  twTitle?: string;
  twDescription?: string;
  robots?: string;
  jsonLd?: string[];
  home?: boolean;
  preloadImage?: string;
}
const {
  title, description, canonical, ogType = 'website', ogTitle = title, ogDescription = description,
  twTitle = ogTitle, twDescription = ogDescription, robots, jsonLd = [], home = false, preloadImage,
} = Astro.props;
const ogImage = 'https://dev.rhuanfreire.com.br/images/og-cover-1200x630.jpg';
---
<!doctype html>
<html lang="pt-BR" class="fx-js" {...(home ? { 'data-fx-home': '', 'data-header-auto': '' } : {})}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Rhuan Freire">
{robots && <meta name="robots" content={robots}>}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content="pt_BR">
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={twTitle}>
<meta name="twitter:description" content={twDescription}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin>
<link rel="preload" as="font" type="font/woff2" href={interTightUrl} crossorigin>
{preloadImage && <link rel="preload" as="image" href={preloadImage}>}
{jsonLd.map((j) => <script type="application/ld+json" set:html={j} />)}
<script is:inline>
(function(d){
  d.classList.add('fx-js');
  if(d.hasAttribute('data-fx-home')){
    // Gates de efeito: tela de carregamento em todo carregamento da home; fallback libera o conteúdo se o JS falhar
    d.classList.add('fx-header-hide','fx-loading');
    setTimeout(function(){d.classList.add('fx-fallback');d.classList.remove('fx-loading')},7000);
  }
})(document.documentElement);
</script>
<script is:inline>
// Google Tag Manager — carrega após interação ou 3s
(function(){
  var loaded=false;
  function loadGTM(){
    if(loaded)return; loaded=true;
    window.dataLayer=window.dataLayer||[];
    window.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});
    var j=document.createElement('script'); j.async=true;
    j.src='https://www.googletagmanager.com/gtm.js?id=GTM-P2M3SV2R';
    document.head.appendChild(j);
  }
  setTimeout(loadGTM,3000);
  ['click','scroll','keydown','touchstart','mousemove'].forEach(function(e){
    document.addEventListener(e,loadGTM,{once:true,passive:true});
  });
})();
</script>
<slot name="head" />
</head>
<body>
<script>import '../scripts/base.js';</script>
<slot />
</body>
</html>
